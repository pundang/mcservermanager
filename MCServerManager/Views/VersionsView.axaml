<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MCServerManager.ViewModels"
             xmlns:views="using:MCServerManager.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="MCServerManager.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">
    <Design.DataContext>
        <vm:VersionsViewModel />
    </Design.DataContext>

    <Panel>
        <ScrollViewer IsVisible="{Binding ManifestDownloaded}">
            <ItemsRepeater ItemsSource="{Binding Versions}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="5" MinRowSpacing="18" MinColumnSpacing="12" ItemsJustification="SpaceAround" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="vm:VersionItemViewModel">
                        <views:VersionCard />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding !ManifestDownloaded}">Downloading version manifest...</TextBlock>
    </Panel>
</UserControl>
