<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MCServerManager.ViewModels"
             xmlns:views="using:MCServerManager.Views"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="MCServerManager.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">
    <Design.DataContext>
        <vm:VersionsViewModel />
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="Auto,*" RowSpacing="16" IsVisible="{Binding ManifestDownloaded}">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="24" VerticalAlignment="Center" FontWeight="SemiBold">Versions</TextBlock>

                <DropDownButton Grid.Column="1" HorizontalAlignment="Right" Content="{Binding VersionChannel}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuItem Header="Release" Command="{Binding FilterVersionsByTypeCommand}" CommandParameter="Release"/>
                            <MenuItem Header="Snapshot" Command="{Binding FilterVersionsByTypeCommand}" CommandParameter="Snapshot"/>
                            <MenuItem Header="Old Beta" Command="{Binding FilterVersionsByTypeCommand}" CommandParameter="Old Beta"/>
                            <MenuItem Header="Old Alpha" Command="{Binding FilterVersionsByTypeCommand}" CommandParameter="Old Alpha"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsRepeater ItemsSource="{Binding FilteredVersions}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="5" MinRowSpacing="18" MinColumnSpacing="12" ItemsJustification="SpaceAround" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="vm:VersionItemViewModel">
                            <views:VersionCard />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Panel IsVisible="{Binding !ManifestDownloaded}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock IsVisible="{Binding !ManifestDownloadError}">Downloading version list...</TextBlock>

            <StackPanel IsVisible="{Binding ManifestDownloadError}" Spacing="16">
                <TextBlock Text="{Binding ManifestDownloadErrorMessage, StringFormat='Failed to download version list: {0}'}" />
                <Button Command="{Binding LoadVersionsCommand}" HorizontalAlignment="Center">Retry</Button>
            </StackPanel>
        </Panel>
    </Panel>
</UserControl>
