<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MCServerManager.ViewModels"
             x:Class="MCServerManager.Views.VersionCard"
             x:DataType="vm:VersionItemViewModel">

    <Border Background="#10ffffff" Padding="8" CornerRadius="10">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Version.Id}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />

            <TextBlock Text="{Binding Version.Type}" Foreground="Gray" HorizontalAlignment="Center" />

            <Button Content="Install"
                    Command="{Binding InstallVersionCommand}"
                    CommandParameter="{Binding Version.Id}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
