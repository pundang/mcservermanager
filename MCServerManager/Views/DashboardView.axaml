<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MCServerManager.Controls"
             xmlns:vm="using:MCServerManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="MCServerManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Design.DataContext>
        <vm:DashboardViewModel />
    </Design.DataContext>

    <!-- Main content area with dashboard metrics -->
    <DockPanel VerticalSpacing="8">
        <TextBlock DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold">Dashboard</TextBlock>

        <UniformGrid RowSpacing="8" ColumnSpacing="8">
            <Border Background="{DynamicResource ButtonBackgroundPointerOver}" CornerRadius="8" Padding="8">
                <DockPanel VerticalSpacing="4">
                    <TextBlock DockPanel.Dock="Top" FontWeight="UltraLight" LetterSpacing="0.5">Memory</TextBlock>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding RamUsagePercentage, StringFormat={}{0:0}%}" />
                        <TextBlock Text="{Binding RamUsage, StringFormat={}{0:0}MB}" Foreground="Gray" />
                    </StackPanel>
                    <controls:Sparkline Points="{Binding RamHistory}" Stroke="#4FC3F7" StrokeThickness="2" Minimum="0" Maximum="100" />
                </DockPanel>
            </Border>

            <Border Background="{DynamicResource ButtonBackgroundPointerOver}" CornerRadius="8" Padding="8">
                <DockPanel VerticalSpacing="4">
                    <TextBlock DockPanel.Dock="Top" FontWeight="UltraLight" LetterSpacing="0.5">CPU</TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CpuUsage, StringFormat={}{0:0}%}" />
                    <controls:Sparkline Points="{Binding CpuHistory}" Stroke="#81C784" StrokeThickness="2" Minimum="0" Maximum="100" />
                </DockPanel>
            </Border>
        </UniformGrid>
    </DockPanel>
</UserControl>
