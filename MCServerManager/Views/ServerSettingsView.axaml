<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MCServerManager.ViewModels"
             xmlns:models="using:MCServerManager.Models"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="MCServerManager.Views.ServerSettingsView"
             x:DataType="vm:ServerSettingsViewModel">
    <Design.DataContext>
        <vm:ServerSettingsViewModel />
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="*,Auto" RowSpacing="8" IsVisible="{Binding !ServerSettingsIsEmpty}">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ServerSettings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ServerSetting">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Key}" x:Name="Key"/>
                                <TextBox Text="{Binding Value}" x:Name="Value"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" ColumnSpacing="16" RowSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="1" HorizontalAlignment="Right" Command="{Binding SaveSettingsCommand}">Save settings</Button>
        </Grid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" IsVisible="{Binding ServerSettingsIsEmpty}" Spacing="16">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                server.properties file not found, please launch the server at least one time
            </TextBlock>

            <Button HorizontalAlignment="Center" Command="{Binding LoadSettingsCommand}">Reload</Button>
        </StackPanel>
    </Panel>
</UserControl>
